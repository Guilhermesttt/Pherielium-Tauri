# Copie para `.env` e preencha. O `.env` está no .gitignore: nunca faça commit de valores reais.
# Os nomes abaixo foram derivados do código (`import.meta.env` no front e `std::env` no Rust).

# ---- Front (variáveis VITE_* vão para o bundle público: só coloque aqui o que pode ser público) ----

# URL do projeto Supabase (obrigatória).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Chave pública do Supabase (obrigatória). A "publishable key" (sb_publishable_...) tem prioridade;
# a anon key antiga ainda é aceita durante a migração. A segurança dos dados vem das policies RLS, não do segredo desta chave.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# VITE_SUPABASE_ANON_KEY=your_legacy_anon_jwt_here

# URL da API (opcional). Em produção o padrão é https://checkpoint-launcher.onrender.com;
# em desenvolvimento o Vite usa um proxy. Só defina para apontar para outro backend.
# VITE_BACKEND_URL=https://your-backend.example.com

# URL do servidor LiveKit (opcional: a API normalmente devolve `serverUrl` junto do token).
# VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# ---- Rust (lido em tempo de execução; nunca embutido no binário) ----

# Chave da Steam Web API, usada para ler a biblioteca e as conquistas (opcional; sem ela esses recursos ficam indisponíveis).
STEAM_API_KEY=your_steam_web_api_key

# Pasta de dados do usuário (opcional, para testes). O padrão é %APPDATA%Phelierium (a grafia é a do código atual).
# PHERIELIUM_USER_DATA=C:\path\to\data
