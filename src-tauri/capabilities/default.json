{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main application window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-execute",
    "shell:allow-open",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "notification:allow-notify",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "global-shortcut:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://checkpoint-launcher.onrender.com/**" },
        { "url": "http://localhost:8787/**" },
        { "url": "https://localhost:8787/**" }
      ]
    },
    "process:default",
    "process:allow-exit"
  ]
}
